      {
        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "SqlServerSource",
            "sqlReaderQuery": "SELECT\n    c.TABLE_CATALOG,\n    c.TABLE_SCHEMA,\n    c.TABLE_NAME,\n    c.COLUMN_NAME,\n    c.ORDINAL_POSITION,\n    c.COLUMN_DEFAULT,\n    c.IS_NULLABLE,\n    c.DATA_TYPE,\n    c.CHARACTER_MAXIMUM_LENGTH,\n    c.CHARACTER_OCTET_LENGTH,\n    c.NUMERIC_PRECISION,\n    c.NUMERIC_PRECISION_RADIX,\n    c.NUMERIC_SCALE,\n    c.DATETIME_PRECISION,\n    c.CHARACTER_SET_CATALOG,\n    c.CHARACTER_SET_SCHEMA,\n    c.CHARACTER_SET_NAME,\n    c.COLLATION_CATALOG,\n    c.COLLATION_SCHEMA,\n    c.COLLATION_NAME,\n    c.DOMAIN_CATALOG,\n    c.DOMAIN_SCHEMA,\n    c.DOMAIN_NAME\nFROM INFORMATION_SCHEMA.COLUMNS AS c\nINNER JOIN INFORMATION_SCHEMA.TABLES AS t\n    ON c.TABLE_SCHEMA = t.TABLE_SCHEMA\n    AND c.TABLE_NAME = t.TABLE_NAME\nWHERE t.TABLE_TYPE = 'BASE TABLE'\n  AND c.TABLE_SCHEMA NOT IN ('dbo', 'sys')\n  AND c.TABLE_NAME NOT LIKE 'v%'\n  AND c.TABLE_NAME NOT IN (\n      'Document',\n      'Illustration',\n      'ProductDocument',\n      'ProductModel'\n  )\nORDER BY\n    c.TABLE_SCHEMA,\n    c.TABLE_NAME,\n    c.ORDINAL_POSITION;",
            "partitionOption": "None",
            "queryTimeout": "02:00:00",
