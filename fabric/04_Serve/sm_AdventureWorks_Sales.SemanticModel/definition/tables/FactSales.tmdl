	measure 'Cumulative Sales %' =
			-- for the Pareto (80/20) chart
			    VAR CurrentSales = [Total Sales]
			    VAR Cumulative =
			        SUMX (
			            FILTER ( ALLSELECTED ( DimProduct[ProductName] ), [Total Sales] >= CurrentSales ),
			            [Total Sales]
			        )
			    RETURN DIVIDE ( Cumulative, CALCULATE ( [Total Sales], ALLSELECTED ( DimProduct[ProductName] ) ) )
		displayFolder: Product
		lineageTag: 1c73f7ae-6035-4c8e-af3f-67db9d17c004

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Sales Rank' = ```
			
			    IF (
			        ISINSCOPE ( DimProduct[ProductName] ),
			        RANKX ( ALLSELECTED ( DimProduct[ProductName] ), [Total Sales], , DESC, DENSE )
			    )
			```
		formatString: 0
		displayFolder: Product
		lineageTag: 6386207a-500e-48fb-a25c-b25128b84281

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Discount %' = DIVIDE ( [Discount Amount], [Total Sales] + [Discount Amount] )
