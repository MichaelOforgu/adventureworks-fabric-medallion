	measure 'Late Shipment %' = ```
			
			    DIVIDE (
			        CALCULATE ( COUNTROWS ( FactSalesOrder ), FactSalesOrder[IsLateShipment] = TRUE () ),
			        COUNTROWS ( FactSalesOrder )
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Orders
		lineageTag: 72b69245-22d5-42aa-802d-d00026b6f12b

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

