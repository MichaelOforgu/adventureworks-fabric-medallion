table FactSales
	lineageTag: af78c49d-1676-4068-987e-14e48bb7e8ce
	sourceLineageTag: [gold].[FactSales]

	measure 'Online Sales' = CALCULATE ( [Total Sales], FactSales[SalesChannel] = "Online" )
		displayFolder: Channel
		lineageTag: e222c3b0-0383-44e0-ae2a-792d77b34c42

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Online Sales %' = DIVIDE ( [Online Sales], [Total Sales] )
		displayFolder: Channel
		lineageTag: c8e7f992-5742-4ee5-a878-c755e824d03f

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reseller Sales' = CALCULATE ( [Total Sales], FactSales[SalesChannel] = "Reseller" )
		displayFolder: Channel
		lineageTag: ad70d51e-ffe7-4f1f-b4f7-0a09d897441b

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Customers = ```
			DISTINCTCOUNT ( FactSales[CustomerKey] )
			
			```
		formatString: 0
		displayFolder: Customers
		lineageTag: 3d637987-5a75-4c0d-9804-bc647f26010f

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'New Customers' = ```
			
			    -- customers whose first-ever order falls inside the selected period
			    VAR StartKey = YEAR ( MIN ( DimDate[Date] ) ) * 10000
			                 + MONTH ( MIN ( DimDate[Date] ) ) * 100
			                 + DAY ( MIN ( DimDate[Date] ) )
			    RETURN
			        COUNTROWS (
			            FILTER (
			                VALUES ( FactSales[CustomerKey] ),
			                CALCULATE ( MIN ( FactSales[OrderDateKey] ), ALL ( DimDate ) ) >= StartKey
			            )
			        )
			
			```
		formatString: 0
		displayFolder: Customers
		lineageTag: 60a30fed-dbcc-4b07-8644-9a5277f42637

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Returning Customers' = [Customers] - [New Customers]
		formatString: 0
		displayFolder: Customers
		lineageTag: 644ba114-7f98-438d-9baf-dcfda91297b2

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Sales per Customer' = DIVIDE ( [Total Sales], [Customers] )
		displayFolder: Customers
		lineageTag: 07c5bb9a-e426-4728-8f7c-1123311410d0

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Days to Ship' = AVERAGE ( FactSalesOrder[DaysToShip] )
