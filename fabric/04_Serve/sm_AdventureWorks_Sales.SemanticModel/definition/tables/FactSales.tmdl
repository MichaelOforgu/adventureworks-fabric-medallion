	measure 'Total Due' = SUM ( FactSalesOrder[TotalDue] )
		displayFolder: Orders
		lineageTag: 44c39ea8-7c09-4d44-b540-44c40ffef3ff

		changedProperty = Name

		changedProperty = DisplayFolder

